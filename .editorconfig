root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.gd]
indent_style = tab

[*.{yml,yaml,json,json.in}]
indent_size = 2

# Written by the Godot editor.
[*.{tscn,tres,godot,uid}]
indent_style = unset
indent_size = unset
insert_final_newline = unset
