; Engine configuration file.

config_version=5

[application]

config/name="SRD Container Viewer"
config/description="3D model viewer sample for XR_EXT_spatial_container"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.8", "Forward Plus")

[debug]

settings/stdout/verbose_stdout=true

[display]

window/vsync/vsync_mode=0

[xr]

openxr/enabled=true
openxr/reference_space=1
openxr/extensions/spatial_container/enabled=true
openxr/extensions/spatial_container/bounds_mode=0
openxr/extensions/spatial_container/bounds=Vector3(0.3, 0.2, 0.2)
shaders/enabled=true
